{
  "name": "ai-knowledge-agent",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,worker,web \"npm run dev -w server\" \"npm run worker -w server\" \"npm run dev -w client\"",
    "dev:api": "npm run dev -w server",
    "dev:worker": "npm run worker -w server",
    "dev:web": "npm run dev -w client",
    "build": "npm run build -w client"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
